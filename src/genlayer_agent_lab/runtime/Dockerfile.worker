# Official multiarchitecture manifest verified from Docker Hub on 2026-09-06.
FROM python:3.12.13-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2
ARG APP_VERSION=0.1.0a2
LABEL io.genlayer.agent-lab.worker.version=$APP_VERSION \
      io.genlayer.agent-lab.worker.protocol="2" \
      io.genlayer.agent-lab.worker.sdk="4f0b358ec98ec148be9b95cdfb0f0e1a6cbe64da0194fdfac3fffc6f5d1d93e2"
COPY requirements.txt /opt/lab-requirements.txt
RUN pip install --no-cache-dir --require-hashes -r /opt/lab-requirements.txt
COPY --chown=10001:10001 package/genlayer_agent_lab /usr/local/lib/python3.12/site-packages/genlayer_agent_lab
COPY --chown=10001:10001 sdk /opt/lab-sdk/gltest-direct
ENV HOME=/tmp PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
USER 10001:10001
WORKDIR /tmp
ENTRYPOINT ["python", "-I", "-B", "-m", "genlayer_agent_lab.runtime.container_worker"]
